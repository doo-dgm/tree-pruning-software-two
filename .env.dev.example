# Plantilla de variables de entorno para desarrollo local.
# Copia este archivo a .env.dev (NO lo subas a git) o crea estos mismos
# secretos en Infisical con el mismo nombre exacto.
#
# Uso con Infisical:
#   infisical secrets set POSTGRES_USER=tp_dev --env=dev
#   ... (uno por variable, o importando este archivo con `infisical secrets import`)
#   infisical run --env=dev -- docker compose -f docker-compose.dev.yml up -d
#   infisical run --env=dev -- ./mvnw spring-boot:run

# ----- PostgreSQL (requerido para compilar/arrancar) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=treepruning
POSTGRES_USER=tp_dev
POSTGRES_PASSWORD=change-me

# ----- MinIO (requerido para compilar/arrancar) -----
# access/secret key son tambien las credenciales root del contenedor MinIO.
# minio-secret-key debe tener minimo 8 caracteres.
STORAGE_MINIO_ENDPOINT=http://localhost:9000
STORAGE_MINIO_PUBLIC_ENDPOINT=
STORAGE_MINIO_BUCKET=treepruning
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=change-me-min-8-chars

# ----- JPA / Hibernate (opcionales, ya tienen default seguro) -----
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_SCHEMA=public

# ----- Servidor (opcional) -----
SERVER_PORT=8080
APP_ENVIRONMENT=local
# Deja publico Swagger/OpenAPI en dev (SecurityConfig lo exige ADMIN si es false)
APP_SWAGGER_PUBLIC=true

# ----- Fallback automatico a MySQL si Postgres no responde -----
# En este momento el driver del pom.xml es mssql-jdbc (SQL Server), no
# mysql-connector-j, asi que este fallback NO puede funcionar tal cual
# esta hoy: se recomienda desactivarlo en dev para evitar el probe inutil.
DATASOURCE_FALLBACK_ENABLED=false

# ----- No bloquean el arranque (lazy), pero se necesitan para que esas
#       features funcionen de verdad -----

# Redis (cache)
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DATABASE=0

# Kafka / Redpanda (invalidacion de cache CDC)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak (login / JWT)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/treepruning
VITE_KEYCLOAK_CLIENT=treepruning

# Strapi (catalogo de mensajes i18n)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# reCAPTCHA (validacion de formularios publicos)
RECAPTCHA_SECRET_KEY=

# Firebase / FCM (notificaciones push) - deja ambas vacias para desactivar
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
